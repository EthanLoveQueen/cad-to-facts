{
  "version": "1",
  "rules": [
    {
      "rule_id": "max-height",
      "version": "1",
      "requirement_refs": ["req-height"],
      "subject_selector": {"entity_kind": "solid"},
      "inputs": [{"name": "height", "predicate": "bbox.extent.z"}],
      "checker": "numeric.compare",
      "parameters": {
        "operator": "<=",
        "threshold": 30.0,
        "unit": "mm",
        "abs_tol": 1e-7
      },
      "severity": "error",
      "source": {"reviewed_by": "example"}
    }
  ]
}
